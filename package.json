{
  "name": "bergampel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bergampel Innsbruck - Tagesplaner fuer Touren rund um Innsbruck",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build:pages": "BUILD_TARGET=pages vite build",
    "preview:pages": "BUILD_TARGET=pages vite build && npx serve build"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
