{
  "name": "bergampel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bergampel Innsbruck - Tagesplaner fuer Touren rund um Innsbruck",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build:pages": "BUILD_TARGET=pages vite build",
    "preview:pages": "BUILD_TARGET=pages vite build && npx serve build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#fixtures/*": "./src/fixtures/*"
  }
}
