# Datenquellen-Modus: "demo" (mitgelieferte Fixtures) oder "live" (echte APIs)
DATA_MODE=demo

# Lawinenlagebericht (EAWS / CAAMLv6, Region AT-07 Tirol)
AVALANCHE_BULLETIN_URL=https://static.avalanche.report/eaws_bulletins/latest/AT-07.json

# GeoSphere Austria Open Data Hub (keine Registrierung noetig)
GEOSPHERE_BASE_URL=https://dataset.api.hub.geosphere.at/v1

# VVT / OGD Tirol: GTFS-RT Endpunkt (benoetigt i.d.R. einen kostenlosen API-Key)
VVT_GTFS_RT_URL=
VVT_API_KEY=

# Cache-Dauer der Serverantworten in Sekunden
CACHE_TTL_SECONDS=900

# Kartenkacheln. Standard ist OpenStreetMap; fuer Oesterreich bietet sich
# basemap.at an (CC BY 4.0), z.B.:
# PUBLIC_TILE_URL=https://mapsneu.wien.gv.at/basemap/bmapgrau/normal/google3857/{z}/{y}/{x}.png
# PUBLIC_TILE_ATTRIBUTION=Datenquelle: basemap.at
PUBLIC_TILE_URL=
PUBLIC_TILE_ATTRIBUTION=

# Verzeichnis mit den GPX-Tourenverlaeufen (eine Datei je Tour-ID)
TRACKS_DIR=data/tracks
